NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3003,http://localhost:3004

MONGO_ROOT_USERNAME=taskflow_admin
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_APP_USERNAME=taskflow_app
MONGO_APP_PASSWORD=change-me-app-password
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=taskflow_board
MONGO_REPLICA_SET=rs0
MONGO_URI=mongodb://taskflow_app:change-me-app-password@localhost:27017/taskflow_board?authSource=taskflow_board&replicaSet=rs0&directConnection=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

MAX_ATTACHMENT_BYTES=10485760
POSITION_REBALANCE_THRESHOLD=48
