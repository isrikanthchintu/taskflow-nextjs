{
  "name": "taskflow-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.12",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.12",
    "@nestjs/swagger": "^11.4.8",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "^8.24.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.12",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.10",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "jest-environment-node-single-context": "^29.4.0",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.11",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "mongodb-memory-server"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@scarf/scarf"
    ]
  }
}
