# This demo uses browser localStorage and does not require environment variables.

# Optional: external Help Centre link for the top bar Help menu. The item is disabled when unset.
# NEXT_PUBLIC_HELP_CENTRE_URL=

# Optional account menu configuration (items are hidden or disabled when unset).
# NEXT_PUBLIC_ACCOUNT_URL=
# NEXT_PUBLIC_FEATURE_SWITCH_ACCOUNTS=true
# NEXT_PUBLIC_FEATURE_LABS=true

# Optional: connect to the TaskFlow Board Platform API (backend/). When unset, the app uses browser localStorage only.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
